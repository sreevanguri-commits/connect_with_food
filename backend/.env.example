# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/connect_with_food

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d

# OTP Configuration (for development)
OTP_EXPIRY=600

# AWS S3 Configuration (optional for production)
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# SMS Provider API Keys (for production)
SMS_API_KEY=your-sms-provider-api-key
SMS_PROVIDER_URL=https://sms-provider-endpoint

# Admin Dashboard Configuration
ADMIN_SECRET=admin-secret-key

# Maps API Key
NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-api-key
